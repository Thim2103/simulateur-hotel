# Create React App loads .env in every environment, including `test` (see
# react-scripts/config/env.js) -- so without this file, `npm test` silently
# made real network calls to the live Supabase project committed in `.env`
# (REACT_APP_SUPABASE_URL/_KEY). This file is loaded before `.env` for the
# `test` environment and dotenv never overrides an already-set variable, so
# blanking both here keeps the whole Jest suite hermetic/offline: `supabase`
# is null in tests exactly like a checkout without Supabase configured, and
# every repository falls back to its mock/local-storage data as designed.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
